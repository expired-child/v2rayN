<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Design.PreviewWith>
        <Border
            Padding="20">
            <!--  Add Controls for Previewer Here  -->
        </Border>
    </Design.PreviewWith>
    <Style
        Selector="DataGrid">
        <Setter
            Property="RowHeight"
            Value="24" />
        <Setter
            Property="ScrollViewer.AllowAutoHide"
            Value="False" />
    </Style>
    <Style
        Selector="PathIcon">
        <Setter
            Property="Width"
            Value="16" />
        <Setter
            Property="Height"
            Value="16" />
        <Setter
            Property="Foreground"
            Value="{DynamicResource ButtonDefaultTertiaryForeground}" />
    </Style>
    <Style
        Selector="TextBox">
        <Setter
            Property="ScrollViewer.AllowAutoHide"
            Value="False" />
    </Style>
    <Style
        Selector="ScrollViewer">
        <Setter
            Property="AllowAutoHide"
            Value="False" />
    </Style>
    <Style
        Selector="TabControl">
        <Setter
            Property="Theme"
            Value="{StaticResource LineTabControl}" />
    </Style>
    <Style
        Selector="Button.IconButton">
        <Setter
            Property="Width"
            Value="{StaticResource IconButtonWidth}" />
        <Setter
            Property="Height"
            Value="{StaticResource IconButtonHeight}" />
        <Setter
            Property="MinWidth"
            Value="{StaticResource IconButtonWidth}" />
        <Setter
            Property="Theme"
            Value="{DynamicResource BorderlessButton}" />
    </Style>
    <Style
        Selector="Border.workspaceCard">
        <Setter
            Property="Background"
            Value="{DynamicResource WorkspaceSurface}" />
        <Setter
            Property="BorderBrush"
            Value="{DynamicResource WorkspaceStroke}" />
        <Setter
            Property="BorderThickness"
            Value="1" />
        <Setter
            Property="CornerRadius"
            Value="10" />
        <Setter
            Property="Padding"
            Value="16" />
    </Style>
    <Style
        Selector="Window.workspace Button">
        <Setter
            Property="CornerRadius"
            Value="9" />
    </Style>
    <Style
        Selector="Window.workspace TextBox">
        <Setter Property="Background" Value="{DynamicResource WorkspaceSurfaceAlt}" />
        <Setter Property="Foreground" Value="{DynamicResource WorkspaceText}" />
        <Setter Property="BorderBrush" Value="{DynamicResource WorkspaceStroke}" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style
        Selector="Window.workspace ComboBox">
        <Setter Property="Background" Value="{DynamicResource WorkspaceSurfaceAlt}" />
        <Setter Property="Foreground" Value="{DynamicResource WorkspaceText}" />
        <Setter Property="BorderBrush" Value="{DynamicResource WorkspaceStroke}" />
        <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style
        Selector="Window.workspace DataGrid">
        <Setter
            Property="RowHeight"
            Value="40" />
        <Setter
            Property="Background"
            Value="{DynamicResource WorkspaceSurface}" />
        <Setter
            Property="HorizontalGridLinesBrush"
            Value="{DynamicResource WorkspaceStroke}" />
    </Style>
    <Style
        Selector="TextBlock.workspaceCaption">
        <Setter
            Property="Foreground"
            Value="{DynamicResource WorkspaceMuted}" />
    </Style>
    <Style
        Selector="RadioButton.workspaceNav">
        <Setter
            Property="HorizontalAlignment"
            Value="Stretch" />
        <Setter
            Property="Foreground"
            Value="{DynamicResource WorkspaceMuted}" />
        <Setter
            Property="Background"
            Value="Transparent" />
        <Setter
            Property="BorderBrush"
            Value="Transparent" />
        <Setter
            Property="FontSize"
            Value="14" />
        <Setter
            Property="Padding"
            Value="12,9" />
        <Setter
            Property="Margin"
            Value="0,1" />
        <Setter
            Property="Cursor"
            Value="Hand" />
        <Setter
            Property="Template">
            <ControlTemplate>
                <Border
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1"
                    Padding="{TemplateBinding Padding}"
                    CornerRadius="8">
                    <ContentPresenter
                        Content="{TemplateBinding Content}"
                        VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style
        Selector="RadioButton.workspaceNav:pointerover">
        <Setter
            Property="Background"
            Value="{DynamicResource WorkspaceSurfaceAlt}" />
    </Style>
    <Style
        Selector="RadioButton.workspaceNav:checked">
        <Setter
            Property="Background"
            Value="{DynamicResource DesignSelectedBackground}" />
        <Setter
            Property="Foreground"
            Value="{DynamicResource WorkspaceText}" />
        <Setter
            Property="FontWeight"
            Value="SemiBold" />
    </Style>
    <Style
        Selector="RadioButton.workspaceNav:focus-visible">
        <Setter
            Property="BorderBrush"
            Value="{DynamicResource WorkspaceAccent}" />
    </Style>
    <Style
        Selector="Button.workspacePrimary, Button.workspaceSecondary, Button.workspaceNavAction">
        <Setter
            Property="Padding"
            Value="12,7" />
        <Setter
            Property="Cursor"
            Value="Hand" />
        <Setter
            Property="CornerRadius"
            Value="10" />
        <Setter
            Property="FontWeight"
            Value="Medium" />
        <Setter
            Property="Template">
            <ControlTemplate>
                <Border
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1"
                    Padding="{TemplateBinding Padding}"
                    CornerRadius="{TemplateBinding CornerRadius}">
                    <ContentPresenter
                        Content="{TemplateBinding Content}"
                        ContentTemplate="{TemplateBinding ContentTemplate}"
                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalContentAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style
        Selector="Button.workspacePrimary">
        <Setter
            Property="Background"
            Value="{DynamicResource WorkspaceAccent}" />
        <Setter
            Property="Foreground"
            Value="{DynamicResource WorkspaceAccentForeground}" />
    </Style>
    <Style
        Selector="Button.workspaceSecondary">
        <Setter
            Property="Background"
            Value="{DynamicResource WorkspaceSurface}" />
        <Setter
            Property="Foreground"
            Value="{DynamicResource WorkspaceText}" />
        <Setter
            Property="BorderBrush"
            Value="{DynamicResource WorkspaceStroke}" />
    </Style>
    <Style
        Selector="Button.workspaceNavAction">
        <Setter
            Property="HorizontalAlignment"
            Value="Stretch" />
        <Setter
            Property="Background"
            Value="Transparent" />
        <Setter
            Property="Foreground"
            Value="{DynamicResource WorkspaceMuted}" />
        <Setter
            Property="HorizontalContentAlignment"
            Value="Left" />
        <Setter
            Property="Padding"
            Value="12,9" />
        <Setter
            Property="Margin"
            Value="0,1" />
        <Setter
            Property="FontSize"
            Value="14" />
    </Style>
    <Style
        Selector="Button.workspacePrimary:pointerover, Button.workspaceSecondary:pointerover, Button.workspaceNavAction:pointerover">
        <Setter
            Property="Opacity"
            Value="0.8" />
    </Style>
    <Style
        Selector="Button.workspaceNavAction.active">
        <Setter
            Property="Background"
            Value="{DynamicResource DesignSelectedBackground}" />
        <Setter
            Property="Foreground"
            Value="{DynamicResource WorkspaceText}" />
        <Setter
            Property="FontWeight"
            Value="SemiBold" />
    </Style>
    <Style
        Selector="Button.workspacePrimary:pressed, Button.workspaceSecondary:pressed, Button.workspaceNavAction:pressed">
        <Setter
            Property="Opacity"
            Value="0.6" />
    </Style>
    <Style
        Selector="Button.workspacePrimary:focus-visible, Button.workspaceSecondary:focus-visible, Button.workspaceNavAction:focus-visible">
        <Setter
            Property="BorderBrush"
            Value="{DynamicResource WorkspaceAccent}" />
    </Style>
    <Style
        Selector="ComboBox.workspaceCombo">
        <Setter
            Property="Background"
            Value="{DynamicResource WorkspaceSurfaceAlt}" />
        <Setter
            Property="Foreground"
            Value="{DynamicResource WorkspaceText}" />
        <Setter
            Property="Padding"
            Value="12,10" />
        <Setter
            Property="BorderBrush"
            Value="{DynamicResource WorkspaceStroke}" />
        <Setter
            Property="CornerRadius"
            Value="10" />
    </Style>
    <Style
        Selector="Window.workspace DataGridColumnHeader">
        <Setter
            Property="Background"
            Value="{DynamicResource WorkspaceSurfaceAlt}" />
        <Setter
            Property="Foreground"
            Value="{DynamicResource WorkspaceMuted}" />
        <Setter
            Property="Padding"
            Value="10,8" />
    </Style>
    <Style Selector="Window.workspace ScrollBar:vertical"><Setter Property="Width" Value="10" /></Style>
    <Style Selector="Window.workspace ScrollBar:horizontal"><Setter Property="Height" Value="10" /></Style>
    <Style Selector="Window.workspace ScrollBar /template/ Thumb"><Setter Property="Background" Value="{DynamicResource WorkspaceMuted}" /><Setter Property="Opacity" Value="0.45" /><Setter Property="CornerRadius" Value="4" /></Style>
    <Style Selector="Window.workspace ScrollBar /template/ Thumb:pointerover"><Setter Property="Opacity" Value="0.8" /></Style>
    <Style Selector="ListBox.workspaceNodes"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" /></Style>
    <Style Selector="ListBox.workspaceNodes ListBoxItem"><Setter Property="AutomationProperties.Name" Value="{ReflectionBinding Remarks}" /><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0,0,12,12" /><Setter Property="Background" Value="Transparent" /></Style>
    <Style Selector="Border.nodeCard"><Setter Property="Width" Value="255" /><Setter Property="MinHeight" Value="104" /><Setter Property="Padding" Value="14" /><Setter Property="CornerRadius" Value="14" /><Setter Property="BorderThickness" Value="1" /><Setter Property="BorderBrush" Value="{DynamicResource WorkspaceStroke}" /><Setter Property="Background" Value="{DynamicResource WorkspaceSurface}" /></Style>
    <Style Selector="Border.nodeCard:pointerover, Border.nodeCard.active"><Setter Property="Background" Value="{DynamicResource DesignSelectedBackground}" /></Style>
    <Style Selector="Border.nodeCard.active, ListBoxItem:selected Border.nodeCard"><Setter Property="BorderBrush" Value="{DynamicResource WorkspaceAccent}" /></Style>
    <Style Selector="Button.workspaceSidebarAction">
        <Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="{DynamicResource WorkspaceMuted}" /><Setter Property="HorizontalContentAlignment" Value="Left" /><Setter Property="Padding" Value="14,7" /><Setter Property="Margin" Value="0,1" /><Setter Property="FontSize" Value="12" /><Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="Button.workspaceSidebarAction:pointerover"><Setter Property="Background" Value="{DynamicResource WorkspaceSurfaceAlt}" /></Style>
    <Style Selector="Expander.workspaceSidebarGroup">
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Style.Resources>
            <Thickness x:Key="ExpanderHeaderMargin">0</Thickness>
            <Thickness x:Key="ExpanderContentPadding">0</Thickness>
            <Thickness x:Key="ExpanderContentBorderThickness">0</Thickness>
            <x:Double x:Key="ExpanderContentMinLength">0</x:Double>
        </Style.Resources>
    </Style>
    <Style Selector="Expander.workspaceSidebarGroup /template/ ToggleButton#ExpanderHeader">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource WorkspaceText}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="Expander.workspaceSidebarGroup /template/ ToggleButton#ExpanderHeader:pointerover">
        <Setter Property="Background" Value="{DynamicResource WorkspaceSurfaceAlt}" />
    </Style>
    <Style Selector="Expander.workspaceSidebarGroup /template/ ToggleButton#ExpanderHeader:pressed">
        <Setter Property="Background" Value="{DynamicResource DesignSelectedBackground}" />
    </Style>
    <Style Selector="Expander.workspaceSidebarGroup /template/ ToggleButton#ExpanderHeader:focus-visible">
        <Setter Property="BorderBrush" Value="{DynamicResource WorkspaceAccent}" />
    </Style>
    <Style Selector="Expander.workspaceSidebarGroup /template/ PathIcon#PART_PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource WorkspaceText}" />
        <Setter Property="Transitions" Value="{x:Null}" />
    </Style>
</Styles>
