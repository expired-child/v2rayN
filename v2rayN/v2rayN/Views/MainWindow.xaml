<base:WindowBase
    x:Class="v2rayN.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="clr-namespace:v2rayN.Base"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:reactiveui="http://reactiveui.net"
    xmlns:resx="clr-namespace:ServiceLib.Resx;assembly=ServiceLib"
    xmlns:view="clr-namespace:v2rayN.Views"
    xmlns:vms="clr-namespace:ServiceLib.ViewModels;assembly=ServiceLib"
    Title="v2rayN"
    Width="1240"
    Height="820"
    MinWidth="820"
    MinHeight="580"
    Foreground="{DynamicResource WorkspaceText}"
    x:TypeArguments="vms:MainWindowViewModel"
    Icon="/Resources/v2rayN.ico"
    ResizeMode="CanResizeWithGrip"
    ShowInTaskbar="True"
    Style="{StaticResource WindowGlobal}"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary
                    Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Popupbox.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter
                x:Key="BoolToVisConverter" />
        </ResourceDictionary>
    </Window.Resources>
    <materialDesign:DialogHost
        Identifier="RootDialog"
        CloseOnClickAway="True"
        materialDesign:TransitionAssist.DisableTransitions="True"
        SnackbarMessageQueue="{Binding ElementName=MainSnackbar, Path=MessageQueue}"
        Style="{StaticResource MaterialDesignEmbeddedDialogHost}">
        <Grid
            Background="{DynamicResource WorkspaceCanvas}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition
                    Width="212" />
                <ColumnDefinition
                    Width="*" />
            </Grid.ColumnDefinitions>
            <Border
                Grid.Column="0"
                Background="{DynamicResource WorkspaceSidebar}"
                BorderBrush="{DynamicResource WorkspaceStroke}"
                BorderThickness="0,0,1,0">
                <DockPanel
                    Margin="16,26,16,18">
                    <StackPanel
                        DockPanel.Dock="Top"
                        Margin="12,0,0,34">
                        <StackPanel
                            Orientation="Horizontal">
                            <Border
                                Width="36"
                                Height="36"
                                CornerRadius="12"
                                Background="{DynamicResource WorkspaceAccent}">
                                <TextBlock
                                    Text="V"
                                    Foreground="{DynamicResource WorkspaceAccentForeground}"
                                    FontSize="23"
                                    FontWeight="Bold"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Border>
                            <TextBlock
                                Text="v2rayN"
                                FontSize="21"
                                FontWeight="SemiBold"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel
                        DockPanel.Dock="Bottom">
                        <Border
                            Height="1"
                            Background="{DynamicResource WorkspaceStroke}"
                            Margin="12,12,12,16" />
                        <Button
                            x:Name="btnQuickSettings"
                            Style="{StaticResource WorkspaceNavAction}">
                            <StackPanel
                                Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Kind="CogOutline"
                                    Width="20"
                                    Height="20"
                                    VerticalAlignment="Center" />
                                <TextBlock
                                    Text="{x:Static resx:ResUI.menuSetting}"
                                    Margin="12,0,0,0"
                                    VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <StackPanel
                            Orientation="Horizontal"
                            Margin="16,12,0,0">
                            <materialDesign:PopupBox
                                StaysOpen="True"
                                Style="{StaticResource MaterialDesignToolForegroundPopupBox}">
                                <materialDesign:PopupBox.ToggleContent>
                                    <TextBlock
                                        Text="{x:Static resx:ResUI.TbAppearance}"
                                        Foreground="{DynamicResource WorkspaceMuted}" />
                                </materialDesign:PopupBox.ToggleContent>
                                <ContentControl
                                    x:Name="pbTheme" />
                            </materialDesign:PopupBox>
                        </StackPanel>
                    </StackPanel>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock
                                Text="{x:Static resx:ResUI.TbWorkspace}"
                                Style="{StaticResource WorkspaceCaption}"
                                Margin="15,0,0,10"
                                FontSize="11" />
                            <RadioButton
                                x:Name="navOverview"
                                GroupName="workspace"
                                Tag="overview"
                                Style="{StaticResource WorkspaceNav}"
                                Checked="WorkspaceNavigation_Changed"
                                Click="WorkspaceNavigation_Changed">
                                <StackPanel
                                    Orientation="Horizontal">
                                    <materialDesign:PackIcon
                                        Kind="ViewDashboardOutline"
                                        Width="20"
                                        Height="20"
                                        VerticalAlignment="Center" />
                                    <TextBlock
                                        Text="{x:Static resx:ResUI.TbOverview}"
                                        Margin="12,0,0,0"
                                        VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton
                                x:Name="navProfiles"
                                GroupName="workspace"
                                Tag="profiles"
                                Style="{StaticResource WorkspaceNav}"
                                Checked="WorkspaceNavigation_Changed"
                                Click="WorkspaceNavigation_Changed">
                                <StackPanel
                                    Orientation="Horizontal">
                                    <materialDesign:PackIcon
                                        Kind="ServerOutline"
                                        Width="20"
                                        Height="20"
                                        VerticalAlignment="Center" />
                                    <TextBlock
                                        Text="{x:Static resx:ResUI.menuServers}"
                                        Margin="12,0,0,0"
                                        VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                            <Button
                                x:Name="btnNavSubscriptions"
                                Style="{StaticResource WorkspaceNavAction}">
                                <StackPanel
                                    Orientation="Horizontal">
                                    <materialDesign:PackIcon
                                        Kind="BookOutline"
                                        Width="20"
                                        Height="20"
                                        VerticalAlignment="Center" />
                                    <TextBlock
                                        Text="{x:Static resx:ResUI.menuSubscription}"
                                        Margin="12,0,0,0"
                                        VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button
                                x:Name="btnNavRouting"
                                Style="{StaticResource WorkspaceNavAction}">
                                <StackPanel
                                    Orientation="Horizontal">
                                    <materialDesign:PackIcon
                                        Kind="Routes"
                                        Width="20"
                                        Height="20"
                                        VerticalAlignment="Center" />
                                    <TextBlock
                                        Text="{x:Static resx:ResUI.menuRouting}"
                                        Margin="12,0,0,0"
                                        VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                        </StackPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <Border Height="1" Background="{DynamicResource WorkspaceStroke}" Margin="12,14,12,8" />
                                <Expander x:Name="navAddConfiguration" Style="{StaticResource WorkspaceSidebarGroup}"
                                    Header="{x:Static resx:ResUI.WorkspaceAddConfiguration}"
                                    AutomationProperties.Name="{x:Static resx:ResUI.WorkspaceAddConfiguration}"
                                    IsExpanded="False">
                                    <StackPanel Margin="8,2,0,6">
                                        <Button x:Name="menuAddServerViaScan" Style="{StaticResource WorkspaceSidebarAction}"><TextBlock Text="{x:Static resx:ResUI.menuAddServerViaScan}" TextWrapping="Wrap" /></Button>
                                        <Button x:Name="menuAddServerViaImage" Style="{StaticResource WorkspaceSidebarAction}"><TextBlock Text="{x:Static resx:ResUI.menuAddServerViaImage}" TextWrapping="Wrap" /></Button>
                                        <Expander x:Name="navManualConfiguration" Style="{StaticResource WorkspaceSidebarGroup}" Margin="8,2,0,2"
                                            Header="{x:Static resx:ResUI.WorkspaceManualConfiguration}"
                                            AutomationProperties.Name="{x:Static resx:ResUI.WorkspaceManualConfiguration}"
                                            IsExpanded="False">
                                            <StackPanel Margin="8,2,0,6">
                                                <Button x:Name="menuAddCustomServer" Style="{StaticResource WorkspaceSidebarAction}"><TextBlock Text="{x:Static resx:ResUI.menuAddCustomServer}" TextWrapping="Wrap" /></Button>
                                                <Button x:Name="menuAddPolicyGroupServer" Style="{StaticResource WorkspaceSidebarAction}"><TextBlock Text="{x:Static resx:ResUI.menuAddPolicyGroupServer}" TextWrapping="Wrap" /></Button>
                                                <Button x:Name="menuAddProxyChainServer" Style="{StaticResource WorkspaceSidebarAction}"><TextBlock Text="{x:Static resx:ResUI.menuAddProxyChainServer}" TextWrapping="Wrap" /></Button>
                                                <Button x:Name="menuAddCustomOutboundServer" Style="{StaticResource WorkspaceSidebarAction}"><TextBlock Text="{x:Static resx:ResUI.menuAddCustomOutboundServer}" TextWrapping="Wrap" /></Button>
                                                <Button x:Name="menuAddVmessServer" Style="{StaticResource WorkspaceSidebarAction}"><TextBlock Text="{x:Static resx:ResUI.menuAddVmessServer}" TextWrapping="Wrap" /></Button>
                                                <Button x:Name="menuAddVlessServer" Style="{StaticResource WorkspaceSidebarAction}"><TextBlock Text="{x:Static resx:ResUI.menuAddVlessServer}" TextWrapping="Wrap" /></Button>
                                                <Button x:Name="menuAddShadowsocksServer" Style="{StaticResource WorkspaceSidebarAction}"><TextBlock Text="{x:Static resx:ResUI.menuAddShadowsocksServer}" TextWrapping="Wrap" /></Button>
                                                <Button x:Name="menuAddTrojanServer" Style="{StaticResource WorkspaceSidebarAction}"><TextBlock Text="{x:Static resx:ResUI.menuAddTrojanServer}" TextWrapping="Wrap" /></Button>
                                                <Button x:Name="menuAddHysteria2Server" Style="{StaticResource WorkspaceSidebarAction}"><TextBlock Text="{x:Static resx:ResUI.menuAddHysteria2Server}" TextWrapping="Wrap" /></Button>
                                                <Button x:Name="menuAddWireguardServer" Style="{StaticResource WorkspaceSidebarAction}"><TextBlock Text="{x:Static resx:ResUI.menuAddWireguardServer}" TextWrapping="Wrap" /></Button>
                                                <Button x:Name="menuAddMasqueServer" Style="{StaticResource WorkspaceSidebarAction}"><TextBlock Text="{x:Static resx:ResUI.menuAddMasqueServer}" TextWrapping="Wrap" /></Button>
                                                <Button x:Name="menuAddSocksServer" Style="{StaticResource WorkspaceSidebarAction}"><TextBlock Text="{x:Static resx:ResUI.menuAddSocksServer}" TextWrapping="Wrap" /></Button>
                                                <Button x:Name="menuAddHttpServer" Style="{StaticResource WorkspaceSidebarAction}"><TextBlock Text="{x:Static resx:ResUI.menuAddHttpServer}" TextWrapping="Wrap" /></Button>
                                                <Button x:Name="menuAddTuicServer" Style="{StaticResource WorkspaceSidebarAction}"><TextBlock Text="{x:Static resx:ResUI.menuAddTuicServer}" TextWrapping="Wrap" /></Button>
                                                <Button x:Name="menuAddAnytlsServer" Style="{StaticResource WorkspaceSidebarAction}"><TextBlock Text="{x:Static resx:ResUI.menuAddAnytlsServer}" TextWrapping="Wrap" /></Button>
                                                <Button x:Name="menuAddNaiveServer" Style="{StaticResource WorkspaceSidebarAction}"><TextBlock Text="{x:Static resx:ResUI.menuAddNaiveServer}" TextWrapping="Wrap" /></Button>
                                            </StackPanel>
                                        </Expander>
                                    </StackPanel>
                                </Expander>
                                <Expander x:Name="navSubscriptionUpdates" Style="{StaticResource WorkspaceSidebarGroup}"
                                    Header="{x:Static resx:ResUI.WorkspaceSubscriptionUpdates}"
                                    AutomationProperties.Name="{x:Static resx:ResUI.WorkspaceSubscriptionUpdates}"
                                    IsExpanded="False">
                                    <StackPanel Margin="8,2,0,6">
                                        <Button x:Name="menuSubUpdate" Style="{StaticResource WorkspaceSidebarAction}"><TextBlock Text="{x:Static resx:ResUI.menuSubUpdate}" TextWrapping="Wrap" /></Button>
                                        <Button x:Name="menuSubUpdateViaProxy" Style="{StaticResource WorkspaceSidebarAction}"><TextBlock Text="{x:Static resx:ResUI.menuSubUpdateViaProxy}" TextWrapping="Wrap" /></Button>
                                        <Button x:Name="menuSubGroupUpdate" Style="{StaticResource WorkspaceSidebarAction}"><TextBlock Text="{x:Static resx:ResUI.menuSubGroupUpdate}" TextWrapping="Wrap" /></Button>
                                        <Button x:Name="menuSubGroupUpdateViaProxy" Style="{StaticResource WorkspaceSidebarAction}"><TextBlock Text="{x:Static resx:ResUI.menuSubGroupUpdateViaProxy}" TextWrapping="Wrap" /></Button>
                                    </StackPanel>
                                </Expander>
                                <Expander x:Name="navAdvancedTools" Style="{StaticResource WorkspaceSidebarGroup}"
                                    Header="{x:Static resx:ResUI.WorkspaceAdvancedTools}"
                                    AutomationProperties.Name="{x:Static resx:ResUI.WorkspaceAdvancedTools}"
                                    IsExpanded="False">
                                    <StackPanel Margin="8,2,0,6">
                                        <Button x:Name="menuDNSSetting" Style="{StaticResource WorkspaceSidebarAction}"><TextBlock Text="{x:Static resx:ResUI.menuDNSSetting}" TextWrapping="Wrap" /></Button>
                                        <Button x:Name="menuFullConfigTemplate" Style="{StaticResource WorkspaceSidebarAction}"><TextBlock Text="{x:Static resx:ResUI.menuFullConfigTemplate}" TextWrapping="Wrap" /></Button>
                                        <Button x:Name="menuGlobalHotkeySetting" Style="{StaticResource WorkspaceSidebarAction}"><TextBlock Text="{x:Static resx:ResUI.menuGlobalHotkeySetting}" TextWrapping="Wrap" /></Button>
                                        <Expander x:Name="navRegionalPresets" Style="{StaticResource WorkspaceSidebarGroup}" Margin="8,2,0,2"
                                            Header="{x:Static resx:ResUI.menuRegionalPresets}"
                                            AutomationProperties.Name="{x:Static resx:ResUI.menuRegionalPresets}"
                                            IsExpanded="False">
                                            <StackPanel Margin="8,2,0,6">
                                                <Button x:Name="menuRegionalPresetsDefault" Style="{StaticResource WorkspaceSidebarAction}"><TextBlock Text="{x:Static resx:ResUI.menuRegionalPresetsDefault}" TextWrapping="Wrap" /></Button>
                                                <Button x:Name="menuRegionalPresetsRussia" Style="{StaticResource WorkspaceSidebarAction}"><TextBlock Text="{x:Static resx:ResUI.menuRegionalPresetsRussia}" TextWrapping="Wrap" /></Button>
                                                <Button x:Name="menuRegionalPresetsIran" Style="{StaticResource WorkspaceSidebarAction}"><TextBlock Text="{x:Static resx:ResUI.menuRegionalPresetsIran}" TextWrapping="Wrap" /></Button>
                                            </StackPanel>
                                        </Expander>
                                        <Border Height="1" Background="{DynamicResource WorkspaceStroke}" Margin="12,8" />
                                        <Button x:Name="menuCheckUpdate" Style="{StaticResource WorkspaceSidebarAction}"><TextBlock Text="{x:Static resx:ResUI.menuCheckUpdate}" TextWrapping="Wrap" /></Button>
                                        <Button x:Name="menuBackupAndRestore" Style="{StaticResource WorkspaceSidebarAction}"><TextBlock Text="{x:Static resx:ResUI.menuBackupAndRestore}" TextWrapping="Wrap" /></Button>
                                        <Button x:Name="menuOpenTheFileLocation" Style="{StaticResource WorkspaceSidebarAction}"><TextBlock Text="{x:Static resx:ResUI.menuOpenTheFileLocation}" TextWrapping="Wrap" /></Button>
                                        <Button x:Name="menuReload" Style="{StaticResource WorkspaceSidebarAction}"><TextBlock Text="{x:Static resx:ResUI.menuReload}" TextWrapping="Wrap" /></Button>
                                        <Button x:Name="menuRebootAsAdmin" Style="{StaticResource WorkspaceSidebarAction}"><TextBlock Text="{x:Static resx:ResUI.menuRebootAsAdmin}" TextWrapping="Wrap" /></Button>
                                        <Button x:Name="menuSettingsSetUWP" Style="{StaticResource WorkspaceSidebarAction}"><TextBlock Text="{x:Static resx:ResUI.TbSettingsSetUWP}" TextWrapping="Wrap" /></Button>
                                        <Button x:Name="menuClearServerStatistics" Style="{StaticResource WorkspaceSidebarAction}"><TextBlock Text="{x:Static resx:ResUI.menuClearServerStatistics}" TextWrapping="Wrap" /></Button>
                                    </StackPanel>
                                </Expander>
                                <Expander x:Name="navHelp" Style="{StaticResource WorkspaceSidebarGroup}"
                                    Header="{x:Static resx:ResUI.menuHelp}"
                                    AutomationProperties.Name="{x:Static resx:ResUI.menuHelp}"
                                    IsExpanded="False">
                                    <StackPanel Margin="8,2,0,6">
                                        <StackPanel x:Name="menuHelp" />
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </DockPanel>
            </Border>
            <DockPanel
                Grid.Column="1"
                Margin="24,20,24,16">
                <DockPanel
                    DockPanel.Dock="Top"
                    Margin="0,0,0,18">
                    <StackPanel
                        DockPanel.Dock="Right"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
<Button
                            x:Name="btnQuickImport"
                            Style="{StaticResource WorkspacePrimaryButton}"
                            Margin="8,0,0,0"
                            ToolTip="{x:Static resx:ResUI.menuAddServerViaClipboard}"
                            AutomationProperties.Name="{x:Static resx:ResUI.TbImport}">
                            <StackPanel
                                Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Kind="Plus"
                                    Width="20"
                                    Height="20"
                                    VerticalAlignment="Center" />
                                <TextBlock
                                    Text="{x:Static resx:ResUI.TbImport}"
                                    Margin="12,0,0,0"
                                    VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <Button
                        x:Name="btnPageBack"
                        DockPanel.Dock="Left"
                        Style="{StaticResource WorkspaceSecondaryButton}"
                        Click="PageBack_Click"
                        Visibility="Collapsed"
                        Margin="0,0,16,0"
                        Content="←"
                        AutomationProperties.Name="{x:Static resx:ResUI.TbBack}" />
                    <StackPanel>
                        <TextBlock
                            x:Name="txtWorkspaceTitle"
                            Text="{x:Static resx:ResUI.TbOverview}"
                            FontSize="22"
                            FontWeight="SemiBold" />
                        <TextBlock
                            x:Name="txtWorkspaceDescription"
                            Text="{x:Static resx:ResUI.TbOverviewDescription}"
                            Style="{StaticResource WorkspaceCaption}"
                            Margin="0,4,0,0" />
                    </StackPanel>
                </DockPanel>
                <DockPanel
                    DockPanel.Dock="Bottom"
                    Margin="2,16,2,0">
                    <TextBlock
                        DockPanel.Dock="Right"
                        Text="v2rayN"
                        Style="{StaticResource WorkspaceCaption}"
                        FontSize="11" />
                    <TextBlock
                        x:Name="txtShellStatus"
                        Style="{StaticResource WorkspaceCaption}"
                        FontSize="11" />
                </DockPanel>
                <Grid>
                    <ScrollViewer
                        x:Name="dashboardPanel"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <ContentControl
                                x:Name="contentStatusBarView" />
                            <Border Style="{StaticResource WorkspaceCard}" Margin="0,18,0,0">
                                <StackPanel>
                                    <TextBlock Text="{x:Static resx:ResUI.WorkspaceQuickActions}" FontSize="16" FontWeight="SemiBold" />
                                    <WrapPanel Margin="0,12,0,0">
                                        <Button x:Name="btnDashboardProfiles" Style="{StaticResource WorkspaceSecondaryButton}" Margin="0,0,10,8" Content="{x:Static resx:ResUI.menuServers}" />
                                        <Button x:Name="btnDashboardSubscriptions" Style="{StaticResource WorkspaceSecondaryButton}" Margin="0,0,10,8" Content="{x:Static resx:ResUI.menuSubscription}" />
                            <Button
                                x:Name="btnQuickUpdate"
                                Style="{StaticResource WorkspaceSecondaryButton}"
                                HorizontalAlignment="Left"
                                Margin="0,0,0,8">
                                <StackPanel
                                    Orientation="Horizontal">
                                    <materialDesign:PackIcon
                                        Kind="Refresh"
                                        Width="20"
                                        Height="20"
                                        VerticalAlignment="Center" />
                                    <TextBlock
                                        Text="{x:Static resx:ResUI.menuSubUpdate}"
                                        Margin="12,0,0,0"
                                        VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                            <Button
                                x:Name="btnNewUpdate"
                                Style="{StaticResource WorkspacePrimaryButton}"
                                Visibility="Collapsed"
                                HorizontalAlignment="Left"
                                Margin="0,12,0,0"
                                Content="{x:Static resx:ResUI.menuNewUpdate}" />
                        </StackPanel>
                    </ScrollViewer>
                    <Border
                        x:Name="workspacePanel"
                        Visibility="Collapsed"
                        Style="{StaticResource WorkspaceCard}"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0">
                        <Grid>
                            <Grid
                                x:Name="gridMain"
                                Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition
                                        Width="3*" />
                                    <ColumnDefinition
                                        Width="10" />
                                    <ColumnDefinition
                                        Width="1*" />
                                </Grid.ColumnDefinitions>
                                <ContentControl
                                    x:Name="tabProfiles"
                                    Grid.Column="0" />
                                <GridSplitter
                                    Grid.Column="1"
                                    HorizontalAlignment="Stretch" />
                                <TabControl
                                    x:Name="tabMain"
                                    Grid.Column="2"
                                    HorizontalContentAlignment="Left">
                                    <TabItem
                                        x:Name="tabMsgView"
                                        Header="{x:Static resx:ResUI.MsgInformationTitle}" />
                                    <TabItem
                                        x:Name="tabClashProxies"
                                        Header="{x:Static resx:ResUI.TbProxies}" />
                                    <TabItem
                                        x:Name="tabClashConnections"
                                        Header="{x:Static resx:ResUI.TbConnections}" />
                                </TabControl>
                            </Grid>
                            <Grid
                                x:Name="gridMain1"
                                Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition
                                        Height="3*" />
                                    <RowDefinition
                                        Height="10" />
                                    <RowDefinition
                                        Height="1*" />
                                </Grid.RowDefinitions>
                                <ContentControl
                                    x:Name="tabProfiles1"
                                    Grid.Row="0" />
                                <GridSplitter
                                    Grid.Row="1"
                                    HorizontalAlignment="Stretch" />
                                <TabControl
                                    x:Name="tabMain1"
                                    Grid.Row="2"
                                    materialDesign:NavigationRailAssist.ShowSelectionBackground="True"
                                    Style="{StaticResource MaterialDesignTabControl}"
                                    TabStripPlacement="Top">
                                    <TabItem
                                        x:Name="tabMsgView1">
                                        <TabItem.Header>
                                            <StackPanel>
                                                <materialDesign:PackIcon
                                                    HorizontalAlignment="Center"
                                                    Kind="MessageTextOutline" />
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    Style="{StaticResource ToolbarTextBlock}"
                                                    Text="{x:Static resx:ResUI.MsgInformationTitle}" />
                                            </StackPanel>
                                        </TabItem.Header>
                                    </TabItem>
                                    <TabItem
                                        x:Name="tabClashProxies1">
                                        <TabItem.Header>
                                            <StackPanel>
                                                <materialDesign:PackIcon
                                                    HorizontalAlignment="Center"
                                                    Kind="ArrowDecisionOutline" />
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    Style="{StaticResource ToolbarTextBlock}"
                                                    Text="{x:Static resx:ResUI.TbProxies}" />
                                            </StackPanel>
                                        </TabItem.Header>
                                    </TabItem>
                                    <TabItem
                                        x:Name="tabClashConnections1">
                                        <TabItem.Header>
                                            <StackPanel>
                                                <materialDesign:PackIcon
                                                    HorizontalAlignment="Center"
                                                    Kind="LanConnect" />
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    Style="{StaticResource ToolbarTextBlock}"
                                                    Text="{x:Static resx:ResUI.TbConnections}" />
                                            </StackPanel>
                                        </TabItem.Header>
                                    </TabItem>
                                </TabControl>
                            </Grid>
                            <Grid
                                x:Name="gridMain2"
                                Visibility="Collapsed">
                                <TabControl
                                    x:Name="tabMain2"
                                    materialDesign:NavigationRailAssist.ShowSelectionBackground="True"
                                    Style="{StaticResource MaterialDesignTabControl}"
                                    TabStripPlacement="Top">
                                    <TabItem
                                        x:Name="tabProfiles2">
                                        <TabItem.Header>
                                            <StackPanel>
                                                <materialDesign:PackIcon
                                                    HorizontalAlignment="Center"
                                                    Kind="Server" />
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    Style="{StaticResource ToolbarTextBlock}"
                                                    Text="{x:Static resx:ResUI.menuServers}" />
                                            </StackPanel>
                                        </TabItem.Header>
                                    </TabItem>
                                    <TabItem
                                        x:Name="tabMsgView2">
                                        <TabItem.Header>
                                            <StackPanel>
                                                <materialDesign:PackIcon
                                                    HorizontalAlignment="Center"
                                                    Kind="MessageTextOutline" />
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    Style="{StaticResource ToolbarTextBlock}"
                                                    Text="{x:Static resx:ResUI.MsgInformationTitle}" />
                                            </StackPanel>
                                        </TabItem.Header>
                                    </TabItem>
                                    <TabItem
                                        x:Name="tabClashProxies2">
                                        <TabItem.Header>
                                            <StackPanel>
                                                <materialDesign:PackIcon
                                                    HorizontalAlignment="Center"
                                                    Kind="ArrowDecisionOutline" />
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    Style="{StaticResource ToolbarTextBlock}"
                                                    Text="{x:Static resx:ResUI.TbProxies}" />
                                            </StackPanel>
                                        </TabItem.Header>
                                    </TabItem>
                                    <TabItem
                                        x:Name="tabClashConnections2">
                                        <TabItem.Header>
                                            <StackPanel>
                                                <materialDesign:PackIcon
                                                    HorizontalAlignment="Center"
                                                    Kind="LanConnect" />
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    Style="{StaticResource ToolbarTextBlock}"
                                                    Text="{x:Static resx:ResUI.TbConnections}" />
                                            </StackPanel>
                                        </TabItem.Header>
                                    </TabItem>
                                </TabControl>
                            </Grid>
                        </Grid>
                    </Border>
                    <Border
                        x:Name="pagePanel"
                        Visibility="Collapsed"
                        Style="{StaticResource WorkspaceCard}"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0">
                        <ContentControl
                            x:Name="pageHost" />
                    </Border>
                </Grid>
            </DockPanel>
