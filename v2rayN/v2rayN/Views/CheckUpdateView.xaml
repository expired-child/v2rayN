<reactiveui:ReactiveUserControl
    x:Class="v2rayN.Views.CheckUpdateView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:v2rayN.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:reactiveui="http://reactiveui.net"
    xmlns:resx="clr-namespace:ServiceLib.Resx;assembly=ServiceLib"
    xmlns:vms="clr-namespace:ServiceLib.ViewModels;assembly=ServiceLib"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:TypeArguments="vms:CheckUpdateViewModel"
    Style="{StaticResource ViewGlobal}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
        <Style x:Key="UpdateListItem" TargetType="ListViewItem" BasedOn="{StaticResource lvItemSelected}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="Surface" Background="{DynamicResource WorkspaceSurfaceAlt}"
                                BorderBrush="{DynamicResource WorkspaceStroke}" BorderThickness="1" CornerRadius="8">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource WorkspaceAccentSoft}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource WorkspaceAccent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <DockPanel Margin="{StaticResource Margin8}">
        <WrapPanel
            Margin="{StaticResource Margin8}"
            HorizontalAlignment="Right"
            DockPanel.Dock="Bottom">

            <TextBlock
                Margin="{StaticResource Margin8}"
                VerticalAlignment="Center"
                Style="{StaticResource ToolbarTextBlock}"
                Text="{x:Static resx:ResUI.TbSettingsEnableUpdateViaProxy}" />
            <ToggleButton
                x:Name="togEnableUpdateViaProxy"
                AutomationProperties.Name="{x:Static resx:ResUI.TbSettingsEnableUpdateViaProxy}"
                Margin="{StaticResource Margin8}"
                HorizontalAlignment="Left" />

            <Button
                x:Name="btnCheckOnly"
                MinWidth="100"
                Margin="{StaticResource Margin8}"
                Content="{x:Static resx:ResUI.menuCheckOnly}"
                Style="{StaticResource DefButton}" />

            <Button
                x:Name="btnCheckUpdate"
                MinWidth="100"
                Margin="{StaticResource Margin8}"
                Content="{x:Static resx:ResUI.menuCheckAndUpdate}"
                IsDefault="True"
                Style="{StaticResource DefButton}" />
        </WrapPanel>

            <ListView
                x:Name="lstCheckUpdates"
                BorderThickness="1"
                HorizontalContentAlignment="Stretch"
                ItemContainerStyle="{StaticResource UpdateListItem}">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Vertical" />
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Margin="{StaticResource Margin8}"
                            Padding="0"
                            VerticalAlignment="Center">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="Auto" MinWidth="88" />
                                    <ColumnDefinition Width="3*" />
                                </Grid.ColumnDefinitions>
                                <ToggleButton
                                    x:Name="togAutoRefresh"
                                    AutomationProperties.Name="{Binding CoreTypeForStorage}"
                                    Grid.Column="0"
                                    Margin="{StaticResource Margin8}"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    IsChecked="{Binding IsSelected}" />

                                <DockPanel
                                    Grid.Column="1"
                                    Margin="{StaticResource MarginLeftRight4}"
                                    Visibility="{Binding ShowCheckPreRelease, Converter={StaticResource BoolToVisConverter}}">
                                    <ToggleButton
                                        AutomationProperties.Name="{x:Static resx:ResUI.TbSettingsEnableCheckPreReleaseUpdate}"
                                        Margin="{StaticResource Margin4}"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        IsChecked="{Binding IsCheckPreRelease}" />
                                    <TextBlock
                                        Margin="{StaticResource Margin4}"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource ToolbarTextBlock}"
                                        Text="{x:Static resx:ResUI.TbSettingsEnableCheckPreReleaseUpdate}"
                                        TextWrapping="Wrap" />
                                </DockPanel>

                                <TextBlock
                                    Grid.Column="2"
                                    Margin="8,0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource ListItemTitle}"
                                    Text="{Binding CoreTypeForStorage}" />
                                <TextBlock
                                    Grid.Column="3"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource ListItemSubTitle}"
                                    Text="{Binding Remarks}"
                                    TextWrapping="WrapWithOverflow" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
    </DockPanel>
</reactiveui:ReactiveUserControl>
