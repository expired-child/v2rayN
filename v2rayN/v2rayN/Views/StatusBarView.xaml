<reactiveui:ReactiveUserControl
    x:Class="v2rayN.Views.StatusBarView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:reactiveui="http://reactiveui.net"
    xmlns:resx="clr-namespace:ServiceLib.Resx;assembly=ServiceLib"
    xmlns:tb="clr-namespace:H.NotifyIcon;assembly=H.NotifyIcon.Wpf"
    xmlns:vms="clr-namespace:ServiceLib.ViewModels;assembly=ServiceLib"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:TypeArguments="vms:StatusBarViewModel"
    Style="{StaticResource ViewGlobal}"
    Background="Transparent"
    Foreground="{DynamicResource WorkspaceText}"
    mc:Ignorable="d">
    <Grid>
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition
                        Width="1.1*" />
                    <ColumnDefinition
                        Width="16" />
                    <ColumnDefinition
                        Width="1*" />
                </Grid.ColumnDefinitions>
                <Border
                    Grid.Column="0"
                    Style="{StaticResource WorkspaceCard}"
                    Background="{DynamicResource WorkspaceAccentSoft}"
                    BorderBrush="{DynamicResource WorkspaceStroke}"
                    MinHeight="148">
                    <DockPanel>
                        <StackPanel
                            DockPanel.Dock="Top"
                            Margin="0,0,0,12">
                            <TextBlock
                                Text="{x:Static resx:ResUI.TbCurrentConnection}"
                                Foreground="{DynamicResource WorkspaceAccent}"
                                FontWeight="Medium" />
                        </StackPanel>
                        <Button
                            DockPanel.Dock="Bottom"
                            Style="{StaticResource WorkspaceSecondaryButton}"
                            HorizontalAlignment="Left"
                            Margin="0,12,0,0"
                            Click="TestConnection_Click"
                            Content="{x:Static resx:ResUI.TbTestConnection}" />
                        <StackPanel>
                            <TextBlock
                                x:Name="txtRunningServerDisplay"
                                FontSize="20"
                                Foreground="{DynamicResource WorkspaceText}"
                                TextTrimming="CharacterEllipsis"
                                FontWeight="SemiBold"
                                TextWrapping="Wrap"
                                Cursor="Hand"
                                ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                            <TextBlock
                                x:Name="txtRunningInfoDisplay"
                                FontSize="13"
                                Foreground="{DynamicResource WorkspaceText}"
                                TextTrimming="CharacterEllipsis"
                                Margin="0,10,0,0"
                                Cursor="Hand"
                                ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border
                    Grid.Column="2"
                    Style="{StaticResource WorkspaceCard}"
                    MinHeight="148">
                    <StackPanel>
                        <TextBlock
                            Text="{x:Static resx:ResUI.TbNetworkTraffic}"
                            Style="{StaticResource WorkspaceCaption}" />
                        <TextBlock
                            x:Name="txtSpeedProxyDisplay"
                            FontSize="17"
                            Foreground="{DynamicResource WorkspaceText}"
                            TextTrimming="CharacterEllipsis"
                            Margin="0,12,0,0"
                            FontWeight="SemiBold"
                            ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                        <TextBlock
                            x:Name="txtSpeedDirectDisplay"
                            FontSize="13"
                            Foreground="{DynamicResource WorkspaceText}"
                            TextTrimming="CharacterEllipsis"
                            Margin="0,6,0,0"
                            ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                        <TextBlock
                            Text="{x:Static resx:ResUI.TbWaitingForTraffic}"
                            Margin="0,10,0,0"
                            Foreground="{DynamicResource WorkspaceMuted}">
                            <TextBlock.Style>
                                <Style
                                    TargetType="TextBlock">
                                    <Setter
                                        Property="Visibility"
                                        Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger
                                            Binding="{Binding ElementName=txtSpeedProxyDisplay, Path=Text}"
                                            Value="">
                                            <Setter
                                                Property="Visibility"
                                                Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger
                                            Binding="{Binding ElementName=txtSpeedProxyDisplay, Path=Text}"
                                            Value="{x:Null}">
                                            <Setter
                                                Property="Visibility"
                                                Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Border
                            Height="1"
                            Background="{DynamicResource WorkspaceStroke}"
                            Margin="0,12,0,10" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition
                                    Width="1*" />
                                <ColumnDefinition
                                    Width="1*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel
                                Grid.Column="0">
                                <TextBlock
                                    x:Name="txtInboundDisplay"
                                    FontSize="12"
                                    Foreground="{DynamicResource WorkspaceText}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                            </StackPanel>
                            <StackPanel
                                Grid.Column="1"
                                Margin="12,0,0,0">
                                <TextBlock
                                    x:Name="txtInboundLanDisplay"
                                    FontSize="12"
                                    Foreground="{DynamicResource WorkspaceText}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
            <TextBlock
                Text="{x:Static resx:ResUI.TbProxyControls}"
                FontSize="16"
                FontWeight="SemiBold"
                Foreground="{DynamicResource WorkspaceText}"
                Margin="2,18,0,10" />
            <Border Style="{StaticResource WorkspaceCard}" Padding="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition
                        Width="1*" />
                    <ColumnDefinition
                        Width="16" />
                    <ColumnDefinition
                        Width="1*" />
                    <ColumnDefinition
                        Width="16" />
                    <ColumnDefinition
                        Width="1*" />
                </Grid.ColumnDefinitions>
                <Border
                    Grid.Column="0"
                    Padding="4,4,8,4">
                    <StackPanel>
                        <TextBlock
                            Text="{x:Static resx:ResUI.menuSystemproxy}"
                            Style="{StaticResource WorkspaceCaption}" />
                        <ComboBox
                            x:Name="cmbSystemProxy"
                            Style="{StaticResource WorkspaceComboBox}"
                            Margin="0,10,0,0"
                            HorizontalAlignment="Stretch"
                            ToolTip="{x:Static resx:ResUI.menuSystemproxy}"
                            AutomationProperties.Name="{x:Static resx:ResUI.menuSystemproxy}">
                            <ComboBoxItem
                                Content="{x:Static resx:ResUI.menuSystemProxyClear}" />
                            <ComboBoxItem
                                Content="{x:Static resx:ResUI.menuSystemProxySet}" />
                            <ComboBoxItem
                                Content="{x:Static resx:ResUI.menuSystemProxyNothing}" />
                            <ComboBoxItem
                                Content="{x:Static resx:ResUI.menuSystemProxyPac}" />
                        </ComboBox>
                    </StackPanel>
                </Border>
                <Border
                    Grid.Column="2"
                    Padding="4,4,8,4">
                    <StackPanel
                        x:Name="spEnableTun">
                        <TextBlock
                            Text="{x:Static resx:ResUI.TbEnableTunAs}"
                            Style="{StaticResource WorkspaceCaption}" />
                        <ToggleButton
                            x:Name="togEnableTun"
                            Style="{StaticResource WorkspaceToggle}"
                            HorizontalAlignment="Left"
                            Margin="0,10,0,0"
                            AutomationProperties.Name="{x:Static resx:ResUI.TbEnableTunAs}" />
                    </StackPanel>
                </Border>
                <Border
                    Grid.Column="4"
                    Padding="4,4,8,4">
                    <StackPanel>
                        <TextBlock
                            Text="{x:Static resx:ResUI.menuRouting}"
                            Style="{StaticResource WorkspaceCaption}" />
                        <ComboBox
                            x:Name="cmbRoutings2"
                            Style="{StaticResource WorkspaceComboBox}"
                            DisplayMemberPath="Remarks"
                            Margin="0,10,0,0"
                            HorizontalAlignment="Stretch"
                            ToolTip="{x:Static resx:ResUI.menuRouting}"
                            AutomationProperties.Name="{x:Static resx:ResUI.menuRouting}" />
                    </StackPanel>
                </Border>
            </Grid>
            </Border>
        </StackPanel>
        <tb:TaskbarIcon
            x:Name="tbNotify"
            IconSource="/Resources/v2rayN.ico"
            NoLeftClickDelay="True"
            ToolTipText="v2rayN">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu Style="{StaticResource WorkspaceTrayMenu}">
                    <MenuItem x:Name="menuShowWindow" Header="{x:Static resx:ResUI.TbDisplayGUI}" FontWeight="SemiBold" />
                    <Separator />
                    <MenuItem x:Name="menuSystemProxyClear" Header="{x:Static resx:ResUI.menuSystemProxyClear}"
                              IsCheckable="True" Click="ProxyMenuItem_Click" />
                    <MenuItem x:Name="menuSystemProxySet" Header="{x:Static resx:ResUI.menuSystemProxySet}"
                              IsCheckable="True" Click="ProxyMenuItem_Click" />
                    <MenuItem x:Name="menuSystemProxyNothing" Header="{x:Static resx:ResUI.menuSystemProxyNothing}"
                              IsCheckable="True" Click="ProxyMenuItem_Click" />
                    <MenuItem x:Name="menuSystemProxyPac" Header="{x:Static resx:ResUI.menuSystemProxyPac}"
                              IsCheckable="True" Click="ProxyMenuItem_Click" />
                    <Separator x:Name="sepRoutings" />
                    <MenuItem x:Name="menuRoutings" Header="{x:Static resx:ResUI.menuRouting}"
                              IsEnabled="{Binding HasItems, RelativeSource={RelativeSource Self}}"
                              SubmenuOpened="SelectionMenu_Opened">
                        <MenuItem.ItemContainerStyle>
                            <Style TargetType="MenuItem" BasedOn="{StaticResource WorkspaceTrayMenuItem}">
                                <Setter Property="Header" Value="{Binding Remarks}" />
                                <Setter Property="IsCheckable" Value="True" />
                                <EventSetter Event="Click" Handler="RoutingMenuItem_Click" />
                            </Style>
                        </MenuItem.ItemContainerStyle>
                    </MenuItem>
                    <MenuItem x:Name="menuServers" Header="{x:Static resx:ResUI.menuServers}"
                              IsEnabled="{Binding HasItems, RelativeSource={RelativeSource Self}}"
                              SubmenuOpened="SelectionMenu_Opened">
                        <MenuItem.ItemContainerStyle>
                            <Style TargetType="MenuItem" BasedOn="{StaticResource WorkspaceTrayMenuItem}">
                                <Setter Property="Header" Value="{Binding Text}" />
                                <Setter Property="IsCheckable" Value="True" />
                                <EventSetter Event="Click" Handler="ServerMenuItem_Click" />
                            </Style>
                        </MenuItem.ItemContainerStyle>
                    </MenuItem>
                    <Separator />
                    <MenuItem x:Name="menuAddServerViaClipboard2" Header="{x:Static resx:ResUI.menuAddServerViaClipboard}" />
                    <MenuItem x:Name="menuAddServerViaScan2" Header="{x:Static resx:ResUI.menuAddServerViaScan}" />
                    <MenuItem Header="{x:Static resx:ResUI.menuSubscription}">
                        <MenuItem x:Name="menuSubUpdate2" Header="{x:Static resx:ResUI.menuSubUpdate}" />
                        <MenuItem x:Name="menuSubUpdateViaProxy2" Header="{x:Static resx:ResUI.menuSubUpdateViaProxy}" />
                    </MenuItem>
                    <MenuItem x:Name="menuCopyProxyCmdToClipboard" Header="{x:Static resx:ResUI.menuCopyProxyCmdToClipboard}" />
                    <Separator />
                    <MenuItem x:Name="menuExit" Header="{x:Static resx:ResUI.menuExit}" />
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>
    </Grid>
</reactiveui:ReactiveUserControl>